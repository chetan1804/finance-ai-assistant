GROQ_API_KEY=replace-with-your-provider-key
# Optional legacy token mapping during migration:
# FINANCE_API_TOKENS={"replace-with-at-least-32-random-characters":1}
# FINANCE_DATA_DIR=/app/data
# Optional PostgreSQL finance database; when omitted, SQLite is used.
# FINANCE_DATABASE_URL=postgresql://finance:replace-with-password@localhost:5432/finance
# FINANCE_DATABASE_PATH=/app/data/finance.db
# FINANCE_DB_POOL_MIN_SIZE=1
# FINANCE_DB_POOL_MAX_SIZE=10
# FINANCE_DB_POOL_TIMEOUT_SECONDS=5
# Optional checkpoint override; otherwise PostgreSQL follows FINANCE_DATABASE_URL.
# FINANCE_CHECKPOINT_URL=postgresql://finance:replace-with-password@localhost:5432/finance
# FINANCE_CHECKPOINT_PATH=/app/data/checkpoints.db
# FINANCE_CHECKPOINT_POOL_MIN_SIZE=1
# FINANCE_CHECKPOINT_POOL_MAX_SIZE=5
# Optional locally; required for distributed production rate limiting.
# FINANCE_REDIS_URL=redis://localhost:6379/0
# FINANCE_ENVIRONMENT=production
# FINANCE_LOG_LEVEL=INFO
# FINANCE_LOG_FORMAT=json
# Required when FINANCE_ENVIRONMENT=production.
# FINANCE_ALLOWED_HOSTS=finance.example.com
# Optional when the React frontend is hosted on a different origin.
# FINANCE_CORS_ORIGINS=https://app.example.com
# FINANCE_HTTPS_REDIRECT=true
# FINANCE_HSTS_SECONDS=31536000
# FINANCE_FORWARDED_ALLOW_IPS=127.0.0.1
# FINANCE_ROOT_PATH=/finance
# FINANCE_UI_DIST=/app/frontend/dist
