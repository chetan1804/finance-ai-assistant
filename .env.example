GROQ_API_KEY=replace-with-your-provider-key
# Optional legacy token mapping during migration:
# FINANCE_API_TOKENS={"replace-with-at-least-32-random-characters":1}
# FINANCE_DATA_DIR=/app/data
# Optional PostgreSQL finance database; when omitted, SQLite is used.
# FINANCE_DATABASE_URL=postgresql://finance:replace-with-password@localhost:5432/finance
# FINANCE_DATABASE_PATH=/app/data/finance.db
# Optional checkpoint override; otherwise PostgreSQL follows FINANCE_DATABASE_URL.
# FINANCE_CHECKPOINT_URL=postgresql://finance:replace-with-password@localhost:5432/finance
# FINANCE_CHECKPOINT_PATH=/app/data/checkpoints.db
# FINANCE_UI_DIST=/app/frontend/dist
