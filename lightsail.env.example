# Copy to lightsail.env. Never commit or bake lightsail.env into an image.
GROQ_API_KEY=replace-with-a-new-groq-key

# Generated by scripts.prepare_lightsail_instance_env.
# POSTGRES_USER=arthnivo
# POSTGRES_DB=arthnivo
# POSTGRES_PASSWORD=generated-locally
# REDIS_PASSWORD=generated-locally

# Use :80 and false until a domain points to the instance static IP.
# For HTTPS, use the domain (for example, app.example.com) and true.
ARTHNIVO_SITE_ADDRESS=:80
FINANCE_ALLOWED_HOSTS=replace-with-static-ip-or-domain
FINANCE_HTTPS_REDIRECT=false

# Optional model overrides. The application defaults are suitable initially.
# FINANCE_LLM_MODEL=llama-3.3-70b-versatile
# FINANCE_LLM_TIMEOUT_SECONDS=20
# FINANCE_LLM_MAX_RETRIES=2
# FINANCE_LLM_MAX_TOKENS=300
